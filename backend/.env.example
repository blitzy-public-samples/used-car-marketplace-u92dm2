# =============================================================================
# Backend environment template - Used Car Marketplace API
# =============================================================================
#
# Copy this file to backend/.env and replace every placeholder value:
#
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored and must stay that way; this template is
# committed, so nothing in it is a secret and nothing in it should be.
#
# WHERE IT IS READ. backend/app/core/config.py declares `env_file = ".env"`,
# resolved against the PROCESS working directory - so the API has to be started
# from backend/ for this file's copy to be picked up:
#
#     cd backend && python -m uvicorn app.main:app --reload --port 8000
#
# Note that pydantic reads .env into Settings only. It does NOT export the
# values to the process environment, so a shell command that needs them (for
# example gcloud) must source them itself.
#
# WHEN IT IS READ. `settings = Settings()` runs while app/core/config.py is
# being imported, and every module imports it, so a required value that is
# missing does not fail on the first request - the application cannot be
# imported at all. The eight required keys below have no defaults.
#
# HOW TO READ THIS FILE. There is exactly one entry per field Settings
# declares, in declaration order. Anything commented out is either an optional
# field or NOT A SETTING AT ALL - the final section says which.
#
# TWO WAYS THE VALUES ARE READ, and they are not equivalent:
#
#   pydantic:  Settings() reads backend/.env directly (quotes are stripped)
#   shell:     cd backend && set -a && . ./.env && set +a
#
# Reading the file half of the pydantic path requires python-dotenv, which
# pydantic v1 uses for `env_file` support. It needs no requirement line of its
# own: `uvicorn[standard]` in backend/requirements.txt declares
# `python-dotenv>=0.13` in its `standard` extra, so installing the manifest
# supplies it. Without it pydantic raises `ImportError: python-dotenv is not
# installed` as soon as a .env file exists, so install the manifest first:
#   pip install -r backend/requirements.txt
#
# CONVENTIONS USED BELOW
# -----------------------------------------------------------------------------
#   * Keys appear in the SAME ORDER they are declared in Settings, so this file
#     can be read alongside the `Settings` class field by field.
#   * Each key carries a one-line note naming the code that reads it.
#   * Values are unquoted except where quoting is genuinely required to keep
#     the file safe to source in a shell - a value containing whitespace, double
#     quotes or a JSON array. python-dotenv strips a matching pair of
#     surrounding quotes, so the quoted and sourced forms produce the same
#     value.
#   * EVERY VALUE HERE IS AN ILLUSTRATIVE PLACEHOLDER, NOT A CREDENTIAL. This
#     file is committed to source control. Real secrets belong in backend/.env
#     (already git-ignored) or in your platform's secret manager - never here.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED - the application will not import without these eight
# -----------------------------------------------------------------------------

# Human-readable service name.
PROJECT_NAME="Used Car Marketplace"

# The API path prefix. backend/app/core/security.py builds its OAuth2
# `tokenUrl` as f'{settings.API_V1_STR}/auth/login', so it must match the
# prefixes backend/app/main.py mounts the routers under.
API_V1_STR=/api

# Symmetric JWT signing key - used by `create_access_token` (encode) and
# `get_current_user` (decode) in backend/app/api/auth.py.
#
# THE VALUE BELOW IS A PLACEHOLDER AND MUST BE REPLACED. It is published in
# this committed template, so any deployment that keeps it is signing tokens
# with a key anybody can read: a token forged offline verifies perfectly, and
# because the `sub` claim is resolved straight into a user document, the forged
# identity can name a verified user and pass the verified-rater gate on
# ratings. Nothing detects that from inside a request. Generate a real key:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Use at least 32 characters - HS256 produces a 256-bit tag, and a key shorter
# than the hash it feeds weakens the construction. Settings accepts any
# non-empty string, so this is a rule you must apply rather than one the
# application enforces for you.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Access-token lifetime in minutes. Consumed by `create_access_token` in
# backend/app/api/auth.py as the default expiry for every token it issues, so
# changing this value changes token lifetime with no code change.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Cloud project id. Read by backend/app/db/firestore.py and
# backend/app/db/cloud_storage.py when they construct their clients.
GOOGLE_CLOUD_PROJECT=my-gcp-project-id

# Cloud Storage bucket for uploaded media. Read by
# backend/app/db/cloud_storage.py.
GOOGLE_CLOUD_STORAGE_BUCKET=my-gcp-bucket-name

# Stripe secret key - assigned to `stripe.api_key` in
# backend/app/services/payment.py. USE A TEST-MODE KEY (sk_test_...) outside
# production; a live key here charges real cards.
STRIPE_API_KEY=sk_test_replace_with_your_stripe_test_key

# Stripe webhook signing secret, for verifying inbound webhook payloads.
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret


# -----------------------------------------------------------------------------
# OPTIONAL - declared with defaults, safe to leave unset
# -----------------------------------------------------------------------------

# Sentry ingest URL. Declared as Optional[str] = None; no code reads it yet.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# JWT signing algorithm. HS256 IS THE ONLY ACCEPTED VALUE - the field is
# declared as Literal['HS256'] and any other value is refused at import.
# Both consumers sign and verify with the symmetric SECRET_KEY above, so an
# asymmetric algorithm has no key pair to use, and 'none' would mean tokens
# are not signed at all. Changing the algorithm is a code change on both
# consumers, not a configuration change.
ALGORITHM=HS256

# Inclusive bounds of the rating score. Tunable, but they are half of a
# CROSS-STACK contract: the client mirrors 1..5 in
# frontend/src/schema/rating.ts, in the five options the star control renders
# and in the "out of 5" text every rating surface reads out, and a separately
# built bundle cannot discover a server environment variable. Change these only
# together with the matching client change - otherwise the interface offers a
# star the server answers with 422. The server side is authoritative:
# backend/app/schema/rating.py builds its score field from these two values.
# RATING_MIN must not exceed RATING_MAX; an inverted pair is refused at import.
RATING_MIN=1
RATING_MAX=5

# Maximum characters accepted in the optional written review, measured on the
# normalised text. Mirrored by the client's live character counter, so the same
# cross-stack note applies.
RATING_REVIEW_MAX_LENGTH=2000

# Days after creation at which an unreciprocated rating publishes under the
# double-blind model. MUST BE AT LEAST 1, and at most 365; both bounds are
# enforced at import. Zero is not a shorter window but the absence of one -
# every rating would be due for publication the instant it was written, which
# silently collapses the reveal that exists so neither party can retaliate
# against the other's score. Only the server reads this value, so it can be
# changed without a client release.
RATING_WINDOW_DAYS=14

# Browser origins allowed to call this API, as a JSON array (pydantic parses a
# List[str] from JSON). backend/app/main.py passes this straight to
# CORSMiddleware alongside allow_credentials=True, so each entry is validated
# at import and these are refused:
#
#   * "*" or "null"                  - any site could then make credentialed
#                                      cross-origin requests and read the reply
#   * a trailing slash, path, query
#     or fragment                    - a browser matches the Origin header by
#                                      exact string, so it could never match
#   * cleartext http:// to a
#     non-loopback host              - credentials would cross the network in
#                                      the clear; http is accepted only for
#                                      localhost, *.localhost, 127.0.0.0/8
#                                      and ::1
#
# Name every deployed origin explicitly, over https:
#   ALLOWED_ORIGINS='["https://app.example.com","https://www.example.com"]'
ALLOWED_ORIGINS='["http://localhost:3000"]'


# -----------------------------------------------------------------------------
# READ BY CODE BUT **NOT DECLARED** IN Settings - setting these has NO effect
# -----------------------------------------------------------------------------
#
# These four keys appear in the source but are absent from Settings, so
# pydantic never loads them and each read raises AttributeError at the moment
# it happens. They are listed here so the gap is visible rather than
# surprising. Declaring them belongs to the features that own them, not to the
# rating feature, and they are deliberately left undeclared: adding a field
# here without an owner invites configuration that looks live and is not.
#
# backend/app/services/document_processing.py reads all three of these, at
# L25/L27 and L49/L51, so `process_maintenance_document` and
# `classify_document` raise AttributeError when called. That module is an
# unfinished stub in any case (both functions carry HUMAN ASSISTANCE NEEDED and
# extract nothing), and no route reaches it today.
# GOOGLE_CLOUD_LOCATION=us
# DOCUMENT_AI_PROCESSOR_ID=
# DOCUMENT_AI_CLASSIFIER_ID=
#
# backend/app/tasks/background_jobs.py names an in-memory Celery transport
# directly instead of reading a broker URL, because no broker is provisioned
# and no task is ever dispatched. There is nothing to configure here; the
# rating window sweep is written so that correctness never depends on a worker.
# CELERY_BROKER_URL=


# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY - read by Google's client libraries, not by Settings
# -----------------------------------------------------------------------------
#
# The Google Cloud SDKs read these from the process environment, so they must
# be EXPORTED by your shell - putting them in backend/.env alone does nothing
# (see the note at the top of this file about pydantic not exporting values).
#
# Point the Firestore client at a local emulator instead of a real project:
#   gcloud emulators firestore start --host-port=localhost:8080
# export FIRESTORE_EMULATOR_HOST=localhost:8080
#
# Make the Cloud Storage client anonymous, so no credential is needed:
# export STORAGE_EMULATOR_HOST=http://localhost:9199
#
# Service-account key for the Vision, Document AI and Storage clients, which
# are constructed at module import and resolve credentials eagerly:
# export GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
