# ---------------------------------------------------------------------------
# Used Car Marketplace - backend environment template
#
#   cp backend/.env.example backend/.env    # then edit the values below
#
# backend/app/core/config.py builds `Settings()` AT IMPORT TIME and every
# setting in the first block is REQUIRED with no default, so `import app.main`
# raises pydantic.ValidationError unless all of them are present.
# ---------------------------------------------------------------------------

# --- REQUIRED by app/core/config.py (Settings) ------------------------------
PROJECT_NAME="Used Car Marketplace"
API_V1_STR="/api"
# Generate a real one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-generate-a-48-byte-url-safe-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=30
GOOGLE_CLOUD_PROJECT="used-car-marketplace-dev"
GOOGLE_CLOUD_STORAGE_BUCKET="used-car-marketplace-dev-media"
# Stripe test-mode credentials. Local placeholders are enough to import and
# boot the app; real `sk_test_...` / `whsec_...` values are required before any
# payment or webhook flow will actually work.
STRIPE_API_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# --- OPTIONAL, already declared in Settings ---------------------------------
# SENTRY_DSN=

# --- REFERENCED BY CODE BUT NOT DECLARED IN Settings (known defects) --------
# These names are read at runtime but are missing from the Settings class, so
# they currently raise AttributeError no matter what is exported here. They are
# listed so the values are ready once the Settings class declares them.
#   app/main.py:28                -> settings.ALLOWED_ORIGINS
#   app/api/auth.py:37,49         -> settings.ALGORITHM
#   app/core/security.py:25,33    -> settings.ALGORITHM
#   app/tasks/background_jobs.py:9-> settings.CELERY_BROKER_URL
ALGORITHM="HS256"
ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
CELERY_BROKER_URL="redis://localhost:6379/0"

# --- Rating / review feature tunables (F-010) -------------------------------
# Consumed once app/core/config.py declares them (each with a default).
RATING_MIN=1
RATING_MAX=5
RATING_REVIEW_MAX_LENGTH=2000
RATING_WINDOW_DAYS=14

# --- Google Cloud client wiring for LOCAL development -----------------------
# app/db/firestore.py, app/db/cloud_storage.py, app/services/ai_vision.py and
# app/services/document_processing.py all construct their Google client at
# module import time, so credentials (or an emulator host) must be resolvable
# before anything can be imported.
#
# Firestore emulator (no credentials needed while this is set):
#   gcloud emulators firestore start --host-port=0.0.0.0:8080
FIRESTORE_EMULATOR_HOST="localhost:8080"
# Makes google-cloud-storage build an anonymous client instead of demanding
# real credentials. There is no local GCS emulator in this project, so any
# actual upload/download call still needs a real bucket + credentials.
STORAGE_EMULATOR_HOST="http://localhost:9199"
# Vision AI and Document AI have no emulator: the client constructors need a
# loadable service-account key even offline. Point this at a real key for any
# actual API call.
GOOGLE_APPLICATION_CREDENTIALS="/opt/gcp-dev/dev-service-account.json"
