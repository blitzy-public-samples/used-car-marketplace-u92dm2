# Added with the root npm workspace manifest: this repository had no ignore rules at
# all, and a root `npm install` (formerly an ENOENT failure) now hoists a large
# node_modules/ tree here. package-lock.json is NOT ignored - the single committed
# root lockfile is what keeps `npm ci` reproducible, locally and in CI.

# npm / Node dependencies (hoisted into one root tree) and frontend build output
node_modules/
frontend/dist/
frontend/build/
# Local environment files - never commit real credentials
.env
.env.*.local
# Python backend artifacts (scripts/setup_environment.sh creates ./venv)
venv/
__pycache__/
*.pyc
# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
